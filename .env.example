# Deployment settings. Copy to .env (same folder as docker-compose.yml) and edit.
# For local development see apps/api/.env.example instead.

# Password for the first sign-in. Change it afterwards in Settings → Security; this value is
# ignored once a password exists in the database (see README for the reset procedure).
APP_INITIAL_PASSWORD=password

# Which devices can reach the app.
#   127.0.0.1 = only this machine (put a reverse proxy with HTTPS in front, see README)
#   0.0.0.0   = every device on your network (plain HTTP; fine on a trusted home LAN)
PLATE_BIND=127.0.0.1
PLATE_PORT=8080

# true when a reverse proxy (Nginx Proxy Manager, Caddy, nginx, Traefik) terminates HTTPS in front
# of Plate. Required behind a proxy: without it the app sees plain http and rejects every sign-in.
TRUST_PROXY=false

# Behind a reverse proxy that runs in Docker on this machine (e.g. Nginx Proxy Manager)? Uncomment
# these three lines, put the proxy's network name in PROXY_NETWORK, and point the proxy at
# http://plate:8080. Plate then publishes no host port; the proxy is the only way in. See README.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=npm_default
# TRUST_PROXY=true

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Open Food Facts "Search online" in the food editor. false = the app makes no outbound calls at all
# (except Web Push reminders, which you switch on per device under More → Reminders).
OFF_LOOKUP_ENABLED=true

# Optional: the contact in the VAPID token sent to push services with every reminder (a mailto:
# address or an https: URL). Push services do not use it to reach you; the default is fine.
# PUSH_VAPID_SUBJECT=mailto:you@example.com

# Only for the optional caddy service.
# PLATE_DOMAIN=plate.example.com
