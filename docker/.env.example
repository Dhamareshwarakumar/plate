# Copy to .env next to docker-compose.yml and edit.

# Password for the first sign-in. Change it afterwards in Settings → Security; this value is
# ignored once a password exists in the database (see README for the reset procedure).
APP_INITIAL_PASSWORD=password

# Host interface the app is published on. 127.0.0.1 = only this machine (use a reverse proxy
# or SSH tunnel to reach it). 0.0.0.0 = every device that can reach this machine.
PLATE_BIND=127.0.0.1
PLATE_PORT=8080

# true when a reverse proxy (Caddy/nginx/Traefik) terminates HTTPS in front of Plate.
TRUST_PROXY=false

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Open Food Facts "Search online" in the food editor. false = the app makes no outbound calls at all.
OFF_LOOKUP_ENABLED=true

# Only for the optional caddy service.
# PLATE_DOMAIN=plate.example.com
