# Local development only. Docker deployments use the .env next to docker-compose.yml instead.
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/plate.db
APP_INITIAL_PASSWORD=password
LOG_LEVEL=debug
NODE_ENV=development

# Optional AI assistance (Phase 11). Off unless AI_PROVIDER is set. `fake` answers with canned
# data and never calls out (screenshots, tests); gemini / openai_compatible need a real key.
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# AI_BASE_URL=
